# Save as /etc/brawl-vpn/gateway.env, root-owned, mode 0600.
# Generate VPN_API_TOKEN with: openssl rand -hex 32
VPN_API_TOKEN=
WG_EXCLUSIVE_INTERFACE=true
WG_INTERFACE=wg-brawl
WG_PUBLIC_INTERFACE=
WG_CLIENT_SUBNET=10.66.0.0/24
WG_GATEWAY_ADDRESS=10.66.0.1
# Generated server public key printed by deploy/prepare-vds.sh.
WG_SERVER_PUBLIC_KEY=
# Public IPv4 address or domain followed by the WireGuard UDP port.
WG_ENDPOINT=
# REQUIRED: reviewed actual Brawl Stars public IPv4 networks, comma separated.
# No guessed Supercell/CDN addresses are provided. Never set 0.0.0.0/0.
GAME_ALLOWED_CIDRS=
VPN_GATEWAY_DATABASE=/var/lib/brawl-vpn/gateway.sqlite
VPN_RECONCILE_SECONDS=15
