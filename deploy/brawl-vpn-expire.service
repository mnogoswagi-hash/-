[Unit]
Description=Revoke expired Brawl VPN peers independently of the Telegram bot
After=network-online.target wg-quick@wg-brawl.service
Requires=wg-quick@wg-brawl.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/brawl-vpn
EnvironmentFile=/etc/brawl-vpn/gateway.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/brawl-vpn/.venv/bin/python -m vpn_gateway.cli expire
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/brawl-vpn /run/xtables.lock
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
